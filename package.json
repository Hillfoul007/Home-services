{
  "name": "laundrify",
  "private": true,
  "version": "2.35.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && node minimal-server.js",
    "dev:standalone-backend": "node standalone-backend.cjs",
    "dev:simple-backend": "node simple-backend.cjs",
    "dev:both": "node run-both.cjs",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm run build:minimal",
    "build:pwa": "cross-env NODE_OPTIONS=--max-old-space-size=800 node --expose-gc scripts/memory-optimized-build.cjs",
    "build:minimal": "cross-env NODE_OPTIONS=--max-old-space-size=800 node --expose-gc scripts/minimal-build.cjs",
    "build:check": "cross-env NODE_OPTIONS=--max-old-space-size=800 tsc -b && cross-env NODE_OPTIONS=--max-old-space-size=800 vite build && cross-env NODE_OPTIONS=--max-old-space-size=800 node scripts/optimize-build.js",
    "build:analyze": "cross-env NODE_OPTIONS=--max-old-space-size=800 vite build --mode production && cross-env NODE_OPTIONS=--max-old-space-size=800 node scripts/bundle-analyzer.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm run start:prod",
    "start:prod": "cd backend && npm install --production && NODE_ENV=production node server-laundry.js",
    "start:backend": "NODE_ENV=production node backend/server-laundry.js",
    "start:frontend": "npx serve -s dist -p 8080",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy:pwa": "npm run build:pwa && chmod +x deploy.sh && ./deploy.sh",
    "render:build": "NODE_OPTIONS=--max-old-space-size=800 npm install && NODE_OPTIONS=--max-old-space-size=800 npm run build:minimal && cd backend && npm install --production && echo 'Build completed successfully'",
    "render:start": "NODE_ENV=production node backend/server-laundry.js",
    "install:all": "npm install && cd backend && npm install",
    "build:production": "NODE_OPTIONS=--max-old-space-size=800 npm run install:all && NODE_OPTIONS=--max-old-space-size=800 npm run build:pwa",
    "deploy:fix": "node scripts/deploy-fix.cjs",
    "postbuild": "node scripts/deploy-fix.cjs",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:android": "npm run build && npx cap copy android && npx cap sync android",
    "generate:keystore": "bash scripts/generate-keystore.sh",
    "build:aab": "bash scripts/build-android-aab.sh",
    "build:aab:user": "bash scripts/build-user-aab.sh",
    "build:aab:rider": "bash scripts/build-rider-aab.sh",
    "build:aab:desk": "bash scripts/build-desk-aab.sh",
    "build:aab:all": "npm run build:aab:user && npm run build:aab:rider && npm run build:aab:desk",
    "migrate:wallet": "node backend/scripts/init-wallet-balance.js"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/app": "^8.0.1",
    "@capacitor/device": "^8.0.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.2",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-hover-card": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@types/leaflet": "^1.9.21",
    "body-parser": "^2.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.0.1",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "google": "^2.1.0",
    "googleapis": "^153.0.0",
    "helmet": "^8.1.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.58.1",
    "react-is": "^19.2.5",
    "react-resizable-panels": "^3.0.3",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.0.0",
    "serve": "^14.2.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.20",
    "vite-plugin-pwa": "^1.0.3"
  }
}
